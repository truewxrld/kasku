<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" scope="request"/>
<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#1b4238"><meta name="description" content="KasKu membantu mengelola keuangan pribadi, anggaran, dan rencana tabungan."><title><c:out value="${pageTitle}"/> · KasKu</title><link rel="icon" href="${ctx}/assets/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="${ctx}/assets/app.css"><script defer src="${ctx}/assets/app.js"></script></head>
<body><a class="skip" href="#main">Lewati ke konten</a><div class="sidebar-backdrop" id="sidebar-backdrop"></div>
<aside class="sidebar" id="sidebar"><a href="${ctx}/app/dashboard" class="brand"><img class="brand-logo" src="${ctx}/assets/favicon.svg" alt="">kas<span class="brand-light">ku</span><span class="brand-period">.</span></a><div class="workspace-label">PERSONAL FINANCE</div>
<nav aria-label="Navigasi utama"><span class="nav-caption">RINGKASAN</span><a class="nav-item ${active=='dashboard'?'active':''}" href="${ctx}/app/dashboard"><svg><use href="${ctx}/assets/icons.svg#dashboard"/></svg>Dashboard<c:if test="${active=='dashboard'}"><i></i></c:if></a>
<span class="nav-caption">KELOLA KEUANGAN</span><c:forEach var="m" items="${modules}"><a class="nav-item ${active==m.key?'active':''}" href="${ctx}/app/${m.key}"><svg><use href="${ctx}/assets/icons.svg#${m.icon}"/></svg><c:out value="${m.title}"/><c:if test="${active==m.key}"><i></i></c:if></a></c:forEach><span class="nav-caption">INSIGHT</span><a class="nav-item ${active=='reports'?'active':''}" href="${ctx}/app/reports"><svg><use href="${ctx}/assets/icons.svg#chart"/></svg>Laporan keuangan</a></nav>
<div class="sidebar-bottom"><div class="small-tip"><svg><use href="${ctx}/assets/icons.svg#spark"/></svg><strong>Langkah kecil, masa depan besar.</strong><p>Mulai dari satu transaksi hari ini.</p></div><div class="profile"><div class="avatar">${sessionScope.isDemo?'ER':'KU'}</div><div><strong><c:out value="${sessionScope.shortName}"/></strong><span>${sessionScope.isDemo?'Akun demo pribadi':'Akun personal'}</span></div><form method="post" action="${ctx}/auth/logout"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="icon-button" aria-label="Keluar" title="Keluar"><svg><use href="${ctx}/assets/icons.svg#logout"/></svg></button></form></div></div></aside>
<div class="main-shell"><header class="topbar"><div class="breadcrumb"><button class="icon-button mobile-menu" id="menu-button" aria-label="Buka navigasi" aria-expanded="false"><svg><use href="${ctx}/assets/icons.svg#menu"/></svg></button><span>Workspace</span><span class="crumb-slash">/</span><strong><c:out value="${pageTitle}"/></strong></div><div class="topbar-right"><span class="today"><svg><use href="${ctx}/assets/icons.svg#calendar"/></svg><c:out value="${todayLabel}"/></span><span class="top-avatar">${sessionScope.isDemo?'ER':'KU'}</span></div></header>
<main id="main"><c:if test="${not empty sessionScope.flash}"><div class="notice success" role="status"><svg><use href="${ctx}/assets/icons.svg#check"/></svg><c:out value="${sessionScope.flash}"/></div><c:remove var="flash" scope="session"/></c:if><c:if test="${not empty sessionScope.flashError}"><div class="notice error" role="alert"><c:out value="${sessionScope.flashError}"/></div><c:remove var="flashError" scope="session"/></c:if><c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
<c:choose><c:when test="${pageView=='dashboard'}"><jsp:include page="dashboard.jsp"/></c:when><c:when test="${pageView=='list'}"><jsp:include page="list.jsp"/></c:when><c:when test="${pageView=='form'}"><jsp:include page="form.jsp"/></c:when><c:when test="${pageView=='detail'}"><jsp:include page="detail.jsp"/></c:when><c:when test="${pageView=='reports'}"><jsp:include page="reports.jsp"/></c:when><c:otherwise><div class="empty-state"><h1>Halaman belum tersedia</h1><p>Silakan kembali ke dashboard atau coba lagi.</p><a href="${ctx}/app/dashboard" class="btn primary">Dashboard</a></div></c:otherwise></c:choose>
<footer class="app-footer"><span>KasKu <span class="footer-dot">•</span> Ruang untuk rencana baikmu.</span><span>Muhammad Elmiro Rayhan · 5025231296</span></footer></main></div>
<dialog id="delete-dialog"><div class="dialog-icon"><svg><use href="${ctx}/assets/icons.svg#trash"/></svg></div><h2>Hapus data ini?</h2><p id="delete-description">Data yang dihapus tidak dapat dikembalikan.</p><div class="form-actions"><button class="btn secondary" id="cancel-delete" type="button">Batal</button><button class="btn danger" id="confirm-delete" type="button">Ya, hapus</button></div></dialog>
</body></html>

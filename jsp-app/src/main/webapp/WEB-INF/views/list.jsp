<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="page-heading"><div><div class="eyebrow"><span></span> KELOLA DENGAN LEBIH TERARAH</div><h1><c:out value="${module.title}"/></h1><p><c:out value="${module.description}"/></p></div><a class="btn primary" href="${ctx}/app/${module.key}/new"><svg><use href="${ctx}/assets/icons.svg#plus"/></svg>Tambah <c:out value="${module.singular}"/></a></section>
<div class="section-toolbar"><div><span class="section-label">Semua <c:out value="${module.singular}"/></span><span class="count-pill">${total}</span></div><form class="search-form" method="get" action="${ctx}/app/${module.key}"><div class="search-input"><svg><use href="${ctx}/assets/icons.svg#search"/></svg><input type="search" name="q" value="<c:out value='${query}'/>" placeholder="Cari ${module.singular}..." aria-label="Cari ${module.singular}"></div><c:if test="${module.key=='transactions'||module.key=='categories'}"><select name="kind" aria-label="Filter jenis"><option value="">Semua jenis</option value="income" ${kind=='income'?'selected':''}>Pemasukan</option><option value="expense" ${kind=='expense'?'selected':''}>Pengeluaran</option></select></c:if><button class="btn secondary" type="submit">Cari</button><c:if test="${not empty query||not empty kind}"><a class="text-link" href="${ctx}/app/${module.key}">Reset</a></c:if></form></div>
<c:choose><c:when test="${empty records}"><section class="panel empty-state"><span class="empty-icon"><svg><use href="${ctx}/assets/icons.svg#${module.icon}"/></svg></span><h2>${not empty query||not empty kind?'Tidak ada data yang cocok.':'Mulai dari satu catatan.'}</h2><p>${not empty query||not empty kind?'Coba kata kunci atau filter lainnya.':'Tambahkan data pertamamu. Rencana yang baik dimulai dari sini.'}</p><a class="btn primary" href="${ctx}/app/${module.key}/new">Tambah <c:out value="${module.singular}"/></a></section></c:when>
<c:when test="${module.key=='wallets'||module.key=='goals'||module.key=='budgets'||module.key=='notes'}"><div class="record-grid ${module.key=='notes'?'note-grid':''}"><c:forEach var="row" items="${records}" varStatus="loop"><article class="record-card ${module.key=='wallets'&&loop.index==0?'featured-wallet':''}"><div class="record-card-top"><span class="item-icon ${row._tone}"><svg><use href="${ctx}/assets/icons.svg#${row._icon}"/></svg></span><c:if test="${not empty row._status}"><span class="pill neutral"><c:out value="${row._status}"/></span></c:if><c:if test="${module.key=='wallets'}"><span class="wallet-wordmark">kasku<span>↗</span></span></c:if></div><a class="record-title" href="${ctx}/app/${module.key}/detail?id=${row.id}"><h2><c:out value="${row._title}"/></h2></a><p class="record-subtitle ${module.key=='notes'?'note-content':''}"><c:out value="${row._subtitle}"/></p><c:if test="${not empty row._amount}"><strong class="record-amount"><c:out value="${row._amount}"/></strong></c:if><c:if test="${module.key=='goals'||module.key=='budgets'}"><div class="progress ${module.key=='budgets'&&row._progress>=80?'amber':''}"><div style="width:${row._bar}%"></div></div></c:if><div class="record-meta"><c:forEach var="cell" items="${row._cells}"><div><span><c:out value="${cell.label}"/></span><strong><c:out value="${cell.value}"/></strong></div></c:forEach></div><div class="card-actions"><a class="text-link" href="${ctx}/app/${module.key}/detail?id=${row.id}">Lihat detail<svg><use href="${ctx}/assets/icons.svg#arrow"/></svg></a><div class="row-actions"><a class="icon-button" href="${ctx}/app/${module.key}/edit?id=${row.id}" aria-label="Edit ${module.singular}" title="Edit"><svg><use href="${ctx}/assets/icons.svg#edit"/></svg></a><form method="post" action="${ctx}/app/${module.key}/delete" class="delete-form" data-title="<c:out value='${row._title}'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${row.id}"><button class="icon-button danger-icon" title="Hapus" aria-label="Hapus ${module.singular}"><svg><use href="${ctx}/assets/icons.svg#trash"/></svg></button></form></div></div></article></c:forEach></div></c:when>
<c:otherwise><section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>${module.key=='transactions'?'Transaksi':module.key=='categories'?'Kategori':module.key=='bills'?'Tagihan':'Nama pihak'}</th><c:forEach var="cell" items="${records[0]._cells}"><th><c:out value="${cell.label}"/></th></c:forEach><c:if test="${module.key!='categories'}"><th class="align-right">${module.key=='debts'?'Sisa nominal':'Nominal'}</th></c:if><th class="align-right">Aksi</th></tr></thead><tbody><c:forEach var="row" items="${records}"><tr><td><a class="table-name" href="${ctx}/app/${module.key}/detail?id=${row.id}"><span class="item-icon ${row._tone}"><svg><use href="${ctx}/assets/icons.svg#${row._icon}"/></svg></span><div><strong><c:out value="${row._title}"/></strong><span><c:out value="${row._subtitle}"/></span></div></a></td><c:forEach var="cell" items="${row._cells}"><td><c:out value="${cell.value}"/></td></c:forEach><c:if test="${module.key!='categories'}"><td class="align-right money-cell ${row.kind=='income'?'positive-text':''}"><c:out value="${row._amount}"/></td></c:if><td><div class="row-actions"><a class="icon-button" href="${ctx}/app/${module.key}/detail?id=${row.id}" title="Detail" aria-label="Lihat detail"><svg><use href="${ctx}/assets/icons.svg#eye"/></svg></a><a class="icon-button" href="${ctx}/app/${module.key}/edit?id=${row.id}" title="Edit" aria-label="Edit ${module.singular}"><svg><use href="${ctx}/assets/icons.svg#edit"/></svg></a><form method="post" action="${ctx}/app/${module.key}/delete" class="delete-form" data-title="<c:out value='${row._title}'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${row.id}"><button class="icon-button danger-icon" title="Hapus" aria-label="Hapus ${module.singular}"><svg><use href="${ctx}/assets/icons.svg#trash"/></svg></button></form></div></td></tr></c:forEach></tbody></table></div></section></c:otherwise></c:choose>
<div class="list-bottom"><p>Menampilkan ${empty records?0:(page-1)*10+1}–${(page-1)*10+records.size()} dari ${total} data</p><c:if test="${pages>1}"><nav class="pagination" aria-label="Halaman data"><c:forEach begin="1" end="${pages}" var="p"><c:url var="pageUrl" value="/app/${module.key}"><c:param name="q" value="${query}"/><c:param name="kind" value="${kind}"/><c:param name="page" value="${p}"/></c:url><a class="${p==page?'current':''}" href="<c:out value='${pageUrl}'/>" aria-label="Halaman ${p}">${p}</a></c:forEach></nav></c:if></div><div class="help-note"><svg><use href="${ctx}/assets/icons.svg#info"/></svg><p><c:out value="${module.help}"/></p></div>

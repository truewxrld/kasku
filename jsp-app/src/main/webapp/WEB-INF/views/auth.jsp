<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${register?'Buat akun':'Selamat datang'} · KasKu</title><link rel="icon" href="${ctx}/assets/favicon.svg"><link rel="stylesheet" href="${ctx}/assets/app.css"><script defer src="${ctx}/assets/app.js"></script></head><body class="auth-body">
<section class="auth-story"><a href="${ctx}/auth/login" class="brand"><img class="brand-logo" src="${ctx}/assets/favicon.svg" alt="">kas<span class="brand-light">ku</span>.</a><div class="story-content"><div class="eyebrow light"><span></span> UANGMU, CERITAMU.</div><h1>Atur hari ini.<br>Wujudkan<br><em>rencana esok.</em></h1><p>Kenali kebiasaan keuanganmu, jaga anggaran,<br>dan beri ruang untuk hal yang berarti.</p><div class="illustration" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="floating-note"><span class="mini-check">✓</span><div>Selangkah lebih dekat<strong>ke target impianmu</strong></div></div><div class="illustration-card"><span>KASKU / PERSONAL</span><svg><use href="${ctx}/assets/icons.svg#wallet"/></svg><div>Rencana baik dimulai di sini.</div><div class="card-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div></div><span class="spark-one">✦</span><span class="spark-two">✧</span></div></div><div class="story-footer">Dibuat untuk hidup yang lebih terencana.<span>© 2026 KasKu</span></div></section>
<main class="auth-panel"><div class="auth-form-wrap"><span class="auth-kicker">SELAMAT DATANG DI KASKU</span><h2>${register?'Mulai cerita barumu.':'Senang melihatmu lagi.'}</h2><p class="muted">${register?'Buat akun dan mulai mengelola keuanganmu.':'Masuk untuk melanjutkan rencana keuanganmu.'}</p><c:if test="${not empty error}"><div class="notice error" role="alert"><c:out value="${error}"/></div></c:if>
<form method="post" action="${ctx}/auth/${register?'register':'login'}" class="auth-form"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><c:if test="${register}"><label for="name">Nama lengkap</label><input id="name" name="name" autocomplete="name" minlength="2" maxlength="100" value="<c:out value='${name}'/>" required placeholder="Nama lengkapmu"></c:if><label for="email">Alamat email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="160" value="<c:out value='${email}'/>" placeholder="nama@email.com" required><label for="password">Kata sandi</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="${register?'new-password':'current-password'}" minlength="8" maxlength="128" placeholder="Minimal 8 karakter" required><button id="toggle-password" type="button" class="icon-button" aria-label="Tampilkan kata sandi"><svg><use href="${ctx}/assets/icons.svg#eye"/></svg></button></div><c:if test="${register}"><p class="field-hint">Gunakan setidaknya 8 karakter. Jangan gunakan kata sandi akun lain.</p></c:if><button class="btn primary wide" type="submit">${register?'Buat akun':'Masuk ke KasKu'}<svg><use href="${ctx}/assets/icons.svg#arrow"/></svg></button></form>
<c:if test="${demoEnabled}"><div class="auth-divider"><span>atau kenalan dulu</span></div><form method="post" action="${ctx}/auth/demo"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="btn secondary wide" type="submit"><svg><use href="${ctx}/assets/icons.svg#spark"/></svg>Jelajahi akun demo</button></form><p class="demo-explanation">Data contoh terpisah untuk setiap sesi demo.</p></c:if><p class="auth-switch">${register?'Sudah punya akun?':'Belum punya akun?'} <a href="${ctx}/auth/${register?'login':'register'}">${register?'Masuk di sini':'Daftar gratis'}</a></p><div class="auth-safe"><svg><use href="${ctx}/assets/icons.svg#shield"/></svg>Keuangan pribadi, ruang pribadi.</div></div><div class="auth-credit">Muhammad Elmiro Rayhan · 5025231296</div></main></body></html>

<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="page-heading"><div><div class="eyebrow"><span></span> LANGKAH BAIK DIMULAI HARI INI</div><h1>Halo, <c:out value="${sessionScope.shortName}"/><span class="hello-spark">✳</span></h1><p>Yuk, lihat bagaimana uangmu bekerja bulan ini.</p></div><a class="btn primary" href="${ctx}/app/transactions/new"><svg><use href="${ctx}/assets/icons.svg#plus"/></svg>Catat transaksi</a></section>
<section class="stats-grid" aria-label="Ringkasan keuangan"><article class="stat-card balance-card"><div class="stat-label">Total saldo<svg><use href="${ctx}/assets/icons.svg#wallet"/></svg></div><div class="stat-amount"><c:out value="${summary.balance}"/></div><div class="stat-foot"><span class="tiny-dot"></span> Di seluruh dompetmu<svg><use href="${ctx}/assets/icons.svg#up"/></svg></div><div class="balance-decoration"></div></article>
<article class="stat-card"><div class="stat-label">Pemasukan<span class="stat-icon green"><svg><use href="${ctx}/assets/icons.svg#down"/></svg></span></div><div class="stat-amount"><c:out value="${summary.income}"/></div><div class="stat-foot"><span class="colored-dot green"></span><c:out value="${monthLabel}"/></div></article>
<article class="stat-card"><div class="stat-label">Pengeluaran<span class="stat-icon orange"><svg><use href="${ctx}/assets/icons.svg#up"/></svg></span></div><div class="stat-amount"><c:out value="${summary.expense}"/></div><div class="stat-foot"><span class="colored-dot orange"></span><c:out value="${monthLabel}"/></div></article>
<article class="stat-card"><div class="stat-label">Selisih bulan ini<span class="stat-icon sand"><svg><use href="${ctx}/assets/icons.svg#pie"/></svg></span></div><div class="stat-amount"><c:out value="${summary.net}"/></div><div class="stat-foot"><span class="pill ${summary.netPositive?'positive':'warning'}">${summary.savingsRate}%</span> dari pemasukan</div></article></section>
<div class="dashboard-grid"><section class="panel cashflow"><div class="panel-heading"><div><h2>Arus kas</h2><p>Perjalanan keuanganmu dalam 6 bulan terakhir</p></div><span class="small-filter">6 bulan<svg><use href="${ctx}/assets/icons.svg#chevron-down"/></svg></span></div><div class="chart-legend"><span><i class="legend-dot income-dot"></i>Pemasukan</span><span><i class="legend-dot expense-dot"></i>Pengeluaran</span></div><div class="line-chart"><div class="chart-y"><span>${summary.chartMax}</span><span>${summary.chartMid}</span><span>0</span></div><svg viewBox="0 0 630 220" role="img" aria-label="Grafik pemasukan dan pengeluaran enam bulan"><defs><linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#407561" stop-opacity=".12"/><stop offset="100%" stop-color="#407561" stop-opacity="0"/></linearGradient></defs><path d="M35 40H595M35 110H595M35 180H595" stroke="#e8eae6" stroke-dasharray="4 5" fill="none"/><polygon stroke="none" points="35,180 ${summary.incomePoints} 595,180" fill="url(#chart-fill)"/><polyline points="${summary.incomePoints}" fill="none" stroke="#376855" stroke-width="3" stroke-linejoin="round"/><polyline points="${summary.expensePoints}" fill="none" stroke="#d4a36b" stroke-width="3" stroke-linejoin="round"/><c:forEach var="point" items="${summary.chart}"><circle cx="${point.x}" cy="${point.ay}" r="3.5" fill="#376855" stroke="white" stroke-width="2"/><circle cx="${point.x}" cy="${point.by}" r="3.5" fill="#d4a36b" stroke="white" stroke-width="2"/><text x="${point.x}" y="214" text-anchor="middle" fill="#858d86" font-size="11"><c:out value="${point.label}"/></text></c:forEach></svg></div></section>
<section class="panel expense-panel"><div class="panel-heading"><div><h2>Ke mana uangmu?</h2><p>Pengeluaran bulan ini</p></div><svg class="muted-icon"><use href="${ctx}/assets/icons.svg#pie"/></svg></div><div class="donut" style="background:conic-gradient(${summary.gradient})"><div><span>Total pengeluaran</span><strong><c:out value="${summary.expense}"/></strong></div></div><div class="expense-legend"><c:forEach var="segment" items="${summary.segments}" end="3"><div><span><i style="background:${segment.color}"></i><c:out value="${segment.name}"/></span><strong>${segment.percent}%</strong></div></c:forEach><c:if test="${empty summary.segments}"><p class="muted center">Belum ada pengeluaran bulan ini.</p></c:if></div></section>
<section class="panel recent-panel"><div class="panel-heading"><div><h2>Transaksi terbaru</h2><p>Catatan kecil untuk gambaran yang lebih jelas</p></div><a href="${ctx}/app/transactions" class="text-link">Lihat semua<svg><use href="${ctx}/assets/icons.svg#arrow"/></svg></a></div><div class="recent-list"><c:forEach var="row" items="${summary.recent}"><a href="${ctx}/app/transactions/detail?id=${row.id}" class="recent-row"><span class="item-icon ${row._tone}"><svg><use href="${ctx}/assets/icons.svg#${row._icon}"/></svg></span><div class="recent-name"><strong><c:out value="${row._title}"/></strong><span><c:out value="${row.category_name}"/> <i>·</i> <c:out value="${row.wallet_name}"/></span></div><div class="recent-value ${row.kind=='income'?'positive-text':''}"><strong><c:out value="${row._amount}"/></strong><span><c:out value="${row._cells[1].value}"/></span></div></a></c:forEach><c:if test="${empty summary.recent}"><div class="empty-small">Belum ada transaksi. <a href="${ctx}/app/transactions/new">Catat transaksi pertama</a>.</div></c:if></div></section>
<section class="panel goals-panel"><div class="panel-heading"><div><h2>Selangkah lebih dekat</h2><p>Untuk hal yang sedang kamu impikan</p></div><a class="icon-button" href="${ctx}/app/goals" aria-label="Lihat target tabungan"><svg><use href="${ctx}/assets/icons.svg#arrow"/></svg></a></div><c:forEach var="g" items="${summary.goals}"><a href="${ctx}/app/goals/detail?id=${g.id}" class="mini-goal"><div class="mini-goal-top"><span class="item-icon sand"><svg><use href="${ctx}/assets/icons.svg#${g.icon}"/></svg></span><strong><c:out value="${g.name}"/></strong><span>${g._progress}%</span></div><div class="progress"><div style="width:${g._bar}%"></div></div><div class="mini-goal-bottom"><strong><c:out value="${g._amount}"/></strong><span>terkumpul</span></div></a></c:forEach><c:if test="${empty summary.goals}"><div class="empty-small">Apa rencana besarmu? <a href="${ctx}/app/goals/new">Buat target</a>.</div></c:if><div class="goal-foot"><svg><use href="${ctx}/assets/icons.svg#spark"/></svg>Setiap langkah kecil tetap berarti.</div></section>
<section class="panel budget-panel"><div class="panel-heading"><div><h2>Jaga ritme belanjamu</h2><p>Anggaran bulan ini</p></div><a href="${ctx}/app/budgets" class="text-link">Lihat anggaran<svg><use href="${ctx}/assets/icons.svg#arrow"/></svg></a></div><div class="budget-mini-grid"><c:forEach var="b" items="${summary.budgets}"><a href="${ctx}/app/budgets/detail?id=${b.id}" class="budget-mini"><div><strong><c:out value="${b._title}"/></strong><span>${b._progress}%</span></div><div class="progress ${b._progress>=80?'amber':''}"><div style="width:${b._bar}%"></div></div><span><c:out value="${b._cells[0].value}"/> <small>/ <c:out value="${b._amount}"/></small></span></a></c:forEach><c:if test="${empty summary.budgets}"><div class="empty-small">Buat anggaran pertama untuk mulai memantau pengeluaran.</div></c:if></div></section>
<section class="panel bills-panel"><div class="panel-heading"><div><h2>Jangan sampai terlewat</h2><p>Tagihan yang belum lunas</p></div><svg class="muted-icon"><use href="${ctx}/assets/icons.svg#calendar"/></svg></div><c:forEach var="b" items="${summary.bills}"><a class="bill-mini" href="${ctx}/app/bills/detail?id=${b.id}"><span class="item-icon sand"><svg><use href="${ctx}/assets/icons.svg#receipt"/></svg></span><div><strong><c:out value="${b.name}"/></strong><span><c:out value="${b._cells[0].value}"/></span></div><strong><c:out value="${b._amount}"/></strong></a></c:forEach><c:if test="${empty summary.bills}"><div class="empty-small">Tidak ada tagihan tertunda. Kamu sudah siap!</div></c:if></section></div>

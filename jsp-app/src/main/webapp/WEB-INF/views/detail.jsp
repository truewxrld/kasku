<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a class="back-link" href="${ctx}/app/${module.key}">← Kembali ke <c:out value="${module.title}"/></a><section class="page-heading"><div><div class="eyebrow"><span></span> DETAIL <c:out value="${module.title}"/></div><h1><c:out value="${record._title}"/></h1><p><c:out value="${module.description}"/></p></div><a class="btn primary" href="${ctx}/app/${module.key}/edit?id=${record.id}"><svg><use href="${ctx}/assets/icons.svg#edit"/></svg>Edit data</a></section><div class="form-layout"><section class="panel detail-panel"><div class="detail-banner"><span class="item-icon ${record._tone}"><svg><use href="${ctx}/assets/icons.svg#${record._icon}"/></svg></span><div><span><c:out value="${record._status}"/></span><strong><c:out value="${record._amount}"/></strong></div></div><dl class="detail-grid"><c:forEach var="cell" items="${record._details}"><div><dt><c:out value="${cell.label}"/></dt><dd><c:out value="${cell.value}"/></dd></div></c:forEach></dl><div class="detail-bottom"><a class="btn secondary" href="${ctx}/app/${module.key}">Kembali</a><form method="post" action="${ctx}/app/${module.key}/delete" class="delete-form" data-title="<c:out value='${record._title}'/>"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${record.id}"><button class="btn danger-outline"><svg><use href="${ctx}/assets/icons.svg#trash"/></svg>Hapus data</button></form></div></section><aside class="form-aside"><span class="aside-spark">✳</span><h2>Semua detail,<br>lebih jelas.</h2><p><c:out value="${module.help}"/></p></aside></div>

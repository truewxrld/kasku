<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="page-heading"><div><div class="eyebrow"><span></span> KENALI KEBIASAAN BAIKMU</div><h1>Laporan keuangan</h1><p>Lihat gambaran utuh. Buat keputusan berikutnya dengan lebih yakin.</p></div><a class="btn primary" href="${ctx}/app/export?from=${from}&amp;to=${to}"><svg><use href="${ctx}/assets/icons.svg#download"/></svg>Unduh CSV</a></section><section class="panel report-filter"><form action="${ctx}/app/reports" method="get"><div><label for="from">Dari tanggal</label><input type="date" id="from" name="from" value="${from}" required></div><div><label for="to">Sampai tanggal</label><input type="date" id="to" name="to" value="${to}" required></div><button class="btn secondary">Tampilkan laporan</button></form><span><svg><use href="${ctx}/assets/icons.svg#arrows"/></svg>${summary.count} transaksi dalam periode ini</span></section><section class="report-stats"><article class="stat-card"><div class="stat-label">Total pemasukan</div><div class="stat-amount positive-text"><c:out value="${summary.income}"/></div></article><article class="stat-card"><div class="stat-label">Total pengeluaran</div><div class="stat-amount"><c:out value="${summary.expense}"/></div></article><article class="stat-card balance-card"><div class="stat-label">Selisih pemasukan & pengeluaran</div><div class="stat-amount"><c:out value="${summary.net}"/></div></article></section><div class="report-grid"><section class="panel"><div class="panel-heading"><div><h2>Pengeluaran per kategori</h2><p>Bagian terbesar dari pengeluaranmu</p></div></div><div class="report-categories"><c:forEach var="segment" items="${summary.segments}"><div class="report-category"><div><strong><c:out value="${segment.name}"/></strong><span><c:out value="${segment.amount}"/> · ${segment.percent}%</span></div><div class="progress"><div style="width:${segment.percent}%;background:${segment.color}"></div></div></div></c:forEach><c:if test="${empty summary.segments}"><p class="empty-small">Belum ada pengeluaran dalam periode ini.</p></c:if></div></section><aside class="report-insight"><svg><use href="${ctx}/assets/icons.svg#spark"/></svg><span>CATATAN PERIODE INI</span><h2>${summary.savingsRate}%</h2><p>Selisih terhadap total pemasukan.</p><div class="aside-divider"></div><p>${summary.netPositive?'Pemasukan menutup pengeluaran pada periode ini. Lanjutkan kebiasaan mencatatmu.':'Pengeluaran melebihi pemasukan pada periode ini. Lihat kategori pengeluaran untuk mengevaluasi anggaran.'}</p><small>Persentase ditampilkan 0% jika belum ada pemasukan.</small></aside></div><section class="panel table-panel"><div class="panel-heading"><div><h2>Rincian transaksi</h2><p>Data sesuai rentang tanggal yang dipilih</p></div></div><div class="table-scroll"><table><thead><tr><th>Tanggal</th><th>Transaksi</th><th>Kategori</th><th>Dompet</th><th class="align-right">Nominal</th></tr></thead><tbody><c:forEach var="row" items="${summary.transactions}"><tr><td><c:out value="${row._cells[1].value}"/></td><td><a href="${ctx}/app/transactions/detail?id=${row.id}"><c:out value="${row.title}"/></a></td><td><c:out value="${row.category_name}"/></td><td><c:out value="${row.wallet_name}"/></td><td class="align-right money-cell ${row.kind=='income'?'positive-text':''}"><c:out value="${row._amount}"/></td></tr></c:forEach><c:if test="${empty summary.transactions}"><tr><td colspan="5" class="empty-small">Belum ada transaksi dalam periode ini.</td></tr></c:if></tbody></table></div></section>

digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.65", splines=polyline];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10];
 edge [color="#809589", arrowsize=0.65, fontname="DejaVu Sans", fontsize=8, fontcolor="#52695c"];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">Atribut lainnya pada PDM inti</TD></TR></TABLE>>];
goals [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>goals</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">name : VARCHAR(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">target_amount : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">saved_amount : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">deadline : DATE NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">icon : VARCHAR(20) NOT NULL</TD></TR></TABLE>>];
bills [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>bills</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">name : VARCHAR(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">amount : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">due_date : DATE NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">status : VARCHAR(10) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">note : VARCHAR(1000) NULL</TD></TR></TABLE>>];
debts [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>debts</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">person : VARCHAR(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">direction : VARCHAR(10) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">amount : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">paid_amount : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">due_date : DATE NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">note : VARCHAR(1000) NULL</TD></TR></TABLE>>];
notes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>notes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">title : VARCHAR(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">content : VARCHAR(2000) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">label : VARCHAR(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">created_at : TIMESTAMP NOT NULL DEFAULT NOW</TD></TR></TABLE>>];
users -> goals [taillabel="1",headlabel="0..N",label="user_id"];
users -> bills [taillabel="1",headlabel="0..N",label="user_id"];
users -> debts [taillabel="1",headlabel="0..N",label="user_id"];
users -> notes [taillabel="1",headlabel="0..N",label="user_id"];
}
{
  "users": [
    "PK id : BIGINT IDENTITY",
    "name : VARCHAR(100) NOT NULL",
    "UQ email : VARCHAR(160) NOT NULL",
    "password_hash : VARCHAR(255) NOT NULL",
    "is_demo : BOOLEAN NOT NULL DEFAULT FALSE",
    "created_at : TIMESTAMP NOT NULL DEFAULT NOW"
  ],
  "wallets": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "name : VARCHAR(80) NOT NULL",
    "type : VARCHAR(20) NOT NULL",
    "opening_balance : NUMERIC(15,2) NOT NULL",
    "description : VARCHAR(255) NULL",
    "UQ (id, user_id)",
    "UQ (user_id, name)"
  ],
  "categories": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "name : VARCHAR(80) NOT NULL",
    "kind : VARCHAR(10) NOT NULL",
    "color : VARCHAR(20) NOT NULL",
    "UQ (id, user_id)",
    "UQ (user_id, name)"
  ],
  "transactions": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "FK wallet_id : BIGINT NOT NULL",
    "FK category_id : BIGINT NOT NULL",
    "title : VARCHAR(100) NOT NULL",
    "amount : NUMERIC(15,2) NOT NULL",
    "transaction_date : DATE NOT NULL",
    "note : VARCHAR(1000) NULL"
  ],
  "budgets": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "FK category_id : BIGINT NOT NULL",
    "budget_month : VARCHAR(7) NOT NULL",
    "amount_limit : NUMERIC(15,2) NOT NULL",
    "UQ (user_id, category_id, budget_month)"
  ],
  "goals": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "name : VARCHAR(100) NOT NULL",
    "target_amount : NUMERIC(15,2) NOT NULL",
    "saved_amount : NUMERIC(15,2) NOT NULL",
    "deadline : DATE NOT NULL",
    "icon : VARCHAR(20) NOT NULL"
  ],
  "bills": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "name : VARCHAR(100) NOT NULL",
    "amount : NUMERIC(15,2) NOT NULL",
    "due_date : DATE NOT NULL",
    "status : VARCHAR(10) NOT NULL",
    "note : VARCHAR(1000) NULL"
  ],
  "debts": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "person : VARCHAR(100) NOT NULL",
    "direction : VARCHAR(10) NOT NULL",
    "amount : NUMERIC(15,2) NOT NULL",
    "paid_amount : NUMERIC(15,2) NOT NULL",
    "due_date : DATE NOT NULL",
    "note : VARCHAR(1000) NULL"
  ],
  "notes": [
    "PK id : BIGINT IDENTITY",
    "FK user_id : BIGINT NOT NULL",
    "title : VARCHAR(100) NOT NULL",
    "content : VARCHAR(2000) NOT NULL",
    "label : VARCHAR(20) NOT NULL",
    "created_at : TIMESTAMP NOT NULL DEFAULT NOW"
  ]
}
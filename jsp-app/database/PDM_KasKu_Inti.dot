digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.65", splines=polyline];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10];
 edge [color="#809589", arrowsize=0.65, fontname="DejaVu Sans", fontsize=8, fontcolor="#52695c"];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">name : VARCHAR(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">UQ email : VARCHAR(160) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">password_hash : VARCHAR(255) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">is_demo : BOOLEAN NOT NULL DEFAULT FALSE</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">created_at : TIMESTAMP NOT NULL DEFAULT NOW</TD></TR></TABLE>>];
wallets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>wallets</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">name : VARCHAR(80) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">type : VARCHAR(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">opening_balance : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">description : VARCHAR(255) NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">UQ (id, user_id)</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">UQ (user_id, name)</TD></TR></TABLE>>];
categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">name : VARCHAR(80) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">kind : VARCHAR(10) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">color : VARCHAR(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">UQ (id, user_id)</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">UQ (user_id, name)</TD></TR></TABLE>>];
transactions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>transactions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK wallet_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK category_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">title : VARCHAR(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">amount : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">transaction_date : DATE NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">note : VARCHAR(1000) NULL</TD></TR></TABLE>>];
budgets [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#d9e2d9"><TR><TD BGCOLOR="#254f3e" CELLPADDING="9"><FONT COLOR="white"><B>budgets</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">PK id : BIGINT IDENTITY</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK user_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">FK category_id : BIGINT NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">budget_month : VARCHAR(7) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">amount_limit : NUMERIC(15,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="5">UQ (user_id, category_id, budget_month)</TD></TR></TABLE>>];
users -> wallets [taillabel="1",headlabel="0..N",color="#b2bdb2"];
users -> categories [taillabel="1",headlabel="0..N",color="#b2bdb2"];
users -> transactions [taillabel="1",headlabel="0..N",color="#b2bdb2"];
users -> budgets [taillabel="1",headlabel="0..N",color="#b2bdb2"];
wallets -> transactions [taillabel="1",headlabel="0..N",label="(wallet_id, user_id)",color="#295543",penwidth=1.5];
categories -> transactions [taillabel="1",headlabel="0..N",label="(category_id, user_id)",color="#295543",penwidth=1.5];
categories -> budgets [taillabel="1",headlabel="0..N",label="(category_id, user_id)",color="#295543",penwidth=1.5];
}
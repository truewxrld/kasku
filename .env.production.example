# Copy these into your hosting dashboard (Render: Environment tab).
APP_NAME=KasKu
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # run: php artisan key:generate --show
APP_URL=https://your-app.onrender.com

# PostgreSQL (Render) - paste the *Internal Database URL* of your database
DB_CONNECTION=pgsql
DB_URL=

SESSION_DRIVER=database
CACHE_STORE=database
LOG_CHANNEL=stderr
